# pragma-jennifer-version: >=0.26.0

/**
 * Turn the ISO 4217 list (SIX list-one.xml) into src/currencies.j.
 *
 *   jennifer run tools/gen-currencies.j <list-one.xml> <out.j> [minimum]
 *
 * Run through tools/gen-currencies.sh, which downloads the list. Each code is
 * kept once with its minor units; codes whose minor units are "N.A." (gold,
 * the testing and no-currency codes) are left out. A code listed with two
 * different minor units stops the run, and so does a table of fewer than
 * `minimum` currencies (100 by default), the sign of a list in another shape.
 */
use convert;
use fs;
use io;
use lists;
use maps;
use os;
use regex;
use xml;

if (len(os.ARGS) != 3 and len(os.ARGS) != 4) {
    throw Error{kind: "usage", message: "usage: gen-currencies.j <list-one.xml> <out.j> [minimum]"};
}
def minimum as int init 100;
if (len(os.ARGS) == 4) {
    $minimum = convert.toInt(os.ARGS[3]);
}

def doc as xml.Value init xml.decode(fs.readString(os.ARGS[1]));
if (xml.tag($doc) != "ISO_4217") {
    throw Error{kind: "iso4217", message: "not an ISO 4217 list: root is " + xml.tag($doc)};
}
def published as string init xml.attr($doc, "Pblshd");
if (not regex.matches("^[0-9]\{4\}-[0-9]\{2\}-[0-9]\{2\}$", $published)) {
    throw Error{kind: "iso4217", message: "unexpected publication date: " + $published};
}

def digits as map of string to int init {};
for (def entry in xml.findAll($doc, "CcyTbl/CcyNtry")) {
    if (not xml.has($entry, "Ccy")) {
        continue; # a country without a universal currency
    }
    def code as string init xml.text(xml.get($entry, "Ccy"));
    def units as string init xml.text(xml.get($entry, "CcyMnrUnts"));
    if (not regex.matches("^[A-Z]\{3\}$", $code)) {
        throw Error{kind: "iso4217", message: "unexpected code: " + $code};
    }
    if ($units == "N.A.") {
        continue;
    }
    if (not regex.matches("^[0-9]$", $units)) {
        throw Error{
            kind: "iso4217",
            message: "unexpected minor units for " + $code + ": " + $units
        };
    }
    def n as int init convert.toInt($units);
    if (maps.has($digits, $code) and $digits[$code] != $n) {
        throw Error{kind: "iso4217", message: "two minor units for " + $code};
    }
    $digits[$code] = $n;
}
if (len($digits) < $minimum) {
    throw Error{kind: "iso4217", message: "only " + convert.toString(len($digits)) + " currencies"};
}

def out as string init "# SPDX-License-Identifier: LGPL-3.0-only\n" +
    "# SPDX-FileCopyrightText: Copyright (C) 2026 mplx <mplx@jennifer-lang.dev>\n" +
    "# pragma-jennifer-version: >=0.26.0\n" + "\n" + "/**\n" +
    " * The ISO 4217 currency table. Generated by tools/gen-currencies.sh from\n" +
    " * the list SIX publishes for ISO; do not edit by hand.\n" + " *\n" +
    " * @module currencies\n" + " */\n" + "\n" +
    "/** The publication date of the ISO 4217 list the table was made from. */\n" +
    "export def const PUBLISHED as string init \"" + $published + "\";\n" + "\n" + "/**\n" +
    " * Each currency's alphabetic code and its number of minor units: the\n" +
    " * digits after the point (JPY 0, EUR 2, KWD 3).\n" + " */\n" +
    "export def const DIGITS as map of string to int init \{\n";
def codes as list of string init lists.sort(maps.keys($digits));
for (def i as int init 0; $i < len($codes); $i = $i + 1) {
    def sep as string init ",";
    if ($i == len($codes) - 1) {
        $sep = "";
    }
    $out = $out + "    \"" + $codes[$i] + "\": " + convert.toString($digits[$codes[$i]]) + $sep +
        "\n";
}
$out = $out + "\};\n";
fs.writeString(os.ARGS[2], $out);
io.printf("%d currencies, ISO 4217 list of %s\n", len($codes), $published);
