/**
 * The ISO 4217 currency table. Generated by tools/gen-currencies.sh from
 * the list SIX publishes for ISO; do not edit by hand.
 *
 * @module currencies
 */

/** The publication date of the ISO 4217 list the table was made from. */
export def const PUBLISHED as string init "2026-01-31";

/**
 * Each currency's alphabetic code and its number of minor units: the
 * digits after the point (JPY 0, EUR 2, KWD 3).
 */
export def const DIGITS as map of string to int init {"CLF": 4, "EUR": 2, "JPY": 0, "KWD": 3};
